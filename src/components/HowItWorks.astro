---
const steps = [
  {
    num: "01",
    icon: "self_improvement",
    title: "Check In With Yourself",
    desc: "Once a day, take 90 seconds to honestly rate how you feel across key indicators — mood, energy, stress, sleep, and more. Add tags like #Work or #Family to capture context. That's it.",
    color: "var(--sage-100)",
    iconColor: "var(--primary-dark)"
  },
  {
    num: "02",
    icon: "hub",
    title: "Watch the Picture Form",
    desc: "After each week, TheraNode transforms your daily check-ins into clear visual insights — trend charts, balance scores, and behavioral correlations. Patterns you couldn't see in real-time become obvious.",
    color: "rgba(144,193,167,0.2)",
    iconColor: "var(--sage-500)"
  },
  {
    num: "03",
    icon: "trending_up",
    title: "Build Momentum",
    desc: "The more consistently you check in, the smarter your insights become. Daily entries compound week over week into long-term trend graphs and pattern algorithms that grow more accurate and revealing with every node you add.",
    color: "rgba(16,185,129,0.1)",
    iconColor: "var(--accent)"
  },
  {
    num: "04",
    icon: "rocket_launch",
    title: "Take Action",
    desc: "Use your insights to adjust your daily habits, identify what drains you, and double down on what lifts you. If you work with a therapist, share detailed PDF reports with one tap to make your sessions dramatically more effective.",
    color: "rgba(59,130,246,0.1)",
    iconColor: "#3b82f6"
  }
];
---

<section class="how-it-works" id="how-it-works">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label" data-i18n="how.label">How It Works</span>
      <h2 data-i18n="how.h2">Two Minutes a Day. A Lifetime of Clarity.</h2>
      <p data-i18n="how.desc">No expertise needed. No lengthy journals. Just honest check-ins that add up to something powerful.</p>
    </div>
    <div class="steps-grid">
      {steps.map((s, i) => (
        <div class={`step-card reveal reveal-delay-${i + 1}`}>
          <div class="step-num">{s.num}</div>
          <div class="step-icon" style={`background: ${s.color}; color: ${s.iconColor}`}>
            <span class="material-symbols-outlined">{s.icon}</span>
          </div>
          <h3 data-i18n={`how.step${i + 1}.title`}>{s.title}</h3>
          <p data-i18n={`how.step${i + 1}.desc`}>{s.desc}</p>
          {i < steps.length - 1 && (
            <div class="step-arrow" aria-hidden="true">
              <span class="material-symbols-outlined">arrow_forward</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-it-works { padding: 100px 0; background: var(--bg-alt); position: relative; }
  .section-header { text-align: center; margin-bottom: 60px; }
  .section-label {
    display: inline-block; font-size: 12px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--sage-500); margin-bottom: 12px;
  }
  .section-header h2 {
    font-size: clamp(24px, 3.5vw, 34px); font-weight: 700;
    letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 12px;
  }
  .section-header p { font-size: 16px; color: var(--text-secondary); max-width: 520px; margin: 0 auto; }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
    z-index: 1;
  }

  .step-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 36px 24px 40px;
    text-align: center;
    position: relative;
    transition: all var(--transition);
  }
  .step-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
    border-color: var(--sage-300);
  }

  .step-num {
    position: absolute; top: 14px; right: 18px;
    font-size: 44px; font-weight: 800;
    color: var(--sage-100); letter-spacing: -0.04em;
    line-height: 1; user-select: none;
  }

  .step-icon {
    width: 60px; height: 60px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
    transition: transform 0.3s ease;
  }
  .step-card:hover .step-icon { transform: scale(1.1); }
  .step-icon .material-symbols-outlined { font-size: 26px; }

  .step-card h3 {
    font-size: 17px; font-weight: 700;
    color: var(--text-primary); margin-bottom: 12px;
  }
  .step-card p {
    font-size: 13px; line-height: 1.7;
    color: var(--text-secondary);
  }

  /* Arrow connector between cards — visible on desktop only */
  .step-arrow {
    position: absolute;
    right: -22px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 24px;
    height: 24px;
    background: var(--bg-alt);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .step-arrow .material-symbols-outlined {
    font-size: 18px;
    color: var(--sage-500);
    animation: pulse-arrow 2s ease-in-out infinite;
  }
  @keyframes pulse-arrow {
    0%, 100% { opacity: 0.5; transform: translateX(0); }
    50% { opacity: 1; transform: translateX(3px); }
  }

  @media (max-width: 1024px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    /* Hide horizontal arrows on 2-column layout */
    .step-card:nth-child(2) .step-arrow,
    .step-card:nth-child(4) .step-arrow { display: none; }
  }
  @media (max-width: 600px) {
    .steps-grid { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
    .step-arrow {
      right: 50%;
      top: auto;
      bottom: -16px;
      transform: translateX(50%) rotate(90deg);
    }
  }
</style>
