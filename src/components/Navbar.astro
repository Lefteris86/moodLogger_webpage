---
import { Image } from 'astro:assets';
import logo from '../assets/TheraNode_Logo.webp';
---

<nav class="navbar" id="navbar">
  <div class="container nav-inner">
    <a href="/" class="nav-brand">
      <Image src={logo} alt="TheraNode Logo" width={36} height={36} class="nav-logo" />
      <span class="nav-wordmark">TheraNode</span>
    </a>

    <div class="nav-links" id="nav-links">
      <a href="/#features">Features</a>
      <a href="/#how-it-works">How It Works</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/#safety">Safety</a>
      <a href="/#screenshots">App Preview</a>
      <a href="/#faq">FAQ</a>
      <a href="/#contact" class="nav-contact-link">
        <span class="material-symbols-outlined">mail</span>
        Contact
      </a>
    </div>

    <a href="#" class="nav-cta" id="download-cta" target="_blank" rel="noopener noreferrer">
      <svg class="gplay-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 1.33-2.935 1.695-2.345-2.345 2.978-2.68zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/>
      </svg>
      Download App
    </a>

    <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(246, 247, 248, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--card-border);
    transition: box-shadow var(--transition);
  }
  .navbar.scrolled { box-shadow: 0 2px 20px rgba(30,41,59,0.06); }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav-logo { border-radius: 8px; }
  .nav-wordmark {
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-dark);
    letter-spacing: -0.02em;
  }
  .nav-links {
    display: flex;
    gap: 32px;
  }
  .nav-links a {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color var(--transition);
  }
  .nav-links a:hover { color: var(--primary-dark); }
  .nav-cta {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    background: var(--primary-dark);
    padding: 10px 24px;
    border-radius: 100px;
    transition: background var(--transition), transform var(--transition);
  }
  .nav-cta:hover { background: var(--sage-700); transform: translateY(-1px); }
  .nav-cta { display: inline-flex; align-items: center; gap: 8px; }
  .gplay-icon { flex-shrink: 0; }
  .nav-contact-link {
    display: inline-flex !important;
    align-items: center;
    gap: 4px;
  }
  .nav-contact-link .material-symbols-outlined { font-size: 16px; }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .nav-hamburger span {
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: var(--transition);
  }

  @media (max-width: 768px) {
    .nav-links, .nav-cta { display: none; }
    .nav-hamburger { display: flex; }
    .nav-links.open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background: var(--card);
      padding: 24px;
      gap: 20px;
      border-bottom: 1px solid var(--card-border);
      box-shadow: var(--shadow-card);
    }
  }
</style>
