---
/* FAQ — Essential questions only. Full Q&A available in the app. */
const categories = [
  {
    label: "About TheraNode",
    icon: "help_center",
    items: [
      {
        q: "Do I need to be in therapy to use TheraNode?",
        a: "Not at all. TheraNode is designed for everyone who wants to understand their mental patterns better. Whether you're managing daily stress, navigating a tough period, or simply curious about your emotional well-being — TheraNode gives you clarity. If you do work with a therapist, the app becomes even more powerful with its professional PDF export feature."
      },
      {
        q: "Is TheraNode a medical device or substitute for therapy?",
        a: "No. TheraNode is a personal wellness companion and is not a medical device. It does not provide diagnoses. Always consult a qualified healthcare professional for medical advice. TheraNode is designed to complement — not replace — your therapeutic relationship."
      },
      {
        q: "How secure are my logs? Could another app read them?",
        a: "Your data is protected by medical-grade AES-256-CBC encryption. Every time you close the app, your files are scrambled and unreadable to any other app, file explorer, or malicious software. The encryption keys are stored in your phone's hardware security enclave (Android Keystore / iOS Keychain)."
      },
      {
        q: "Does TheraNode sync data to any cloud or backup service?",
        a: "No. TheraNode is designed for absolute privacy. All data is stored 100% locally on your device. It is never uploaded to the cloud or synced to any servers. We have no backend infrastructure, no accounts, and no analytics — ensuring your data stays entirely in your hands."
      }
    ]
  }
];
---

<section class="faq" id="faq">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label" data-i18n="faq.label">Support</span>
      <h2 data-i18n="faq.h2">Common Questions</h2>
      <p data-i18n="faq.desc">Everything you need to know about using TheraNode.</p>
    </div>

    {categories.map((cat, ci) => (
      <div class="faq-category reveal">
        <div class="faq-cat-header">
          <span class="material-symbols-outlined">{cat.icon}</span>
          <h3 data-i18n="faq.label">{cat.label}</h3>
        </div>
        <div class="faq-list">
          {cat.items.map((item, i) => (
            <div class="faq-item" data-faq>
              <button class="faq-trigger" aria-expanded="false">
                <span class="faq-question" data-i18n={`faq.q${i + 1}`}>{item.q}</span>
                <span class="material-symbols-outlined faq-chevron">expand_more</span>
              </button>
              <div class="faq-answer">
                <p data-i18n={`faq.a${i + 1}`}>{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .faq { padding: 100px 0; background: var(--bg); }
  .section-header { text-align: center; margin-bottom: 48px; }
  .section-label {
    display: inline-block; font-size: 12px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--sage-500); margin-bottom: 12px;
  }
  .section-header h2 {
    font-size: clamp(24px, 3.5vw, 34px); font-weight: 700;
    letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 12px;
  }
  .section-header p { font-size: 16px; color: var(--text-secondary); }

  .faq-category { max-width: 720px; margin: 0 auto 40px; }
  .faq-category:last-child { margin-bottom: 0; }
  .faq-cat-header {
    display: flex; align-items: center; gap: 10px; margin-bottom: 16px;
    padding-bottom: 10px; border-bottom: 2px solid var(--sage-100);
  }
  .faq-cat-header .material-symbols-outlined { font-size: 22px; color: var(--primary-dark); }
  .faq-cat-header h3 { font-size: 16px; font-weight: 700; color: var(--text-primary); letter-spacing: 0.02em; }

  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq-item {
    background: var(--card); border: 1px solid var(--card-border);
    border-radius: var(--radius); overflow: hidden; transition: all var(--transition);
  }
  .faq-item:hover { border-color: var(--sage-300); }
  .faq-item.open { border-color: rgba(57,103,82,0.25); box-shadow: 0 2px 12px rgba(57,103,82,0.06); }
  .faq-trigger {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px 22px; background: none; border: none; cursor: pointer;
    text-align: left; font-family: inherit;
  }
  .faq-question { font-size: 14px; font-weight: 600; color: var(--text-primary); line-height: 1.4; }
  .faq-item.open .faq-question { color: var(--primary-dark); }
  .faq-chevron {
    font-size: 22px; color: var(--text-muted);
    transition: transform var(--transition), color var(--transition); flex-shrink: 0;
  }
  .faq-item.open .faq-chevron { transform: rotate(180deg); color: var(--primary-dark); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
  .faq-item.open .faq-answer { max-height: 400px; }
  .faq-answer p { padding: 0 22px 18px; font-size: 14px; line-height: 1.7; color: var(--text-secondary); }
</style>
