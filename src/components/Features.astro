---
const pillars = [
  {
    icon: "shield_lock",
    title: "A True Sanctuary",
    desc: "Your thoughts deserve a safe space. TheraNode encrypts everything on your device with military-grade security. No cloud, no accounts, no one looking over your shoulder. Just you.",
    color: "var(--sage-100)",
    iconColor: "var(--primary-dark)"
  },
  {
    icon: "visibility",
    title: "See What You've Been Missing",
    desc: "Track mood, energy, stress, sleep quality, and 19 more behavioral signals. Over time, TheraNode reveals hidden correlations your conscious mind overlooks — the triggers, the cycles, the connections between your daily life and how you feel.",
    color: "rgba(144,193,167,0.2)",
    iconColor: "var(--sage-500)"
  },
  {
    icon: "auto_stories",
    title: "Your Story, Documented",
    desc: "Every week, TheraNode generates a visual summary of your mental landscape. Share it with your therapist, keep it for yourself, or look back months later to see how far you've come.",
    color: "rgba(16,185,129,0.1)",
    iconColor: "var(--accent)"
  }
];
---

<section class="features" id="features">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">What You Get</span>
      <h2>Simple Tools. Profound Clarity.</h2>
      <p>Everything you need to understand yourself better — in under 2 minutes a day.</p>
    </div>
    <div class="pillars-grid">
      {pillars.map((p, i) => (
        <div class={`pillar-card reveal reveal-delay-${i + 1}`}>
          <div class="pillar-icon" style={`background: ${p.color}; color: ${p.iconColor}`}>
            <span class="material-symbols-outlined">{p.icon}</span>
          </div>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features { padding: 100px 0; background: var(--bg); }
  .section-header { text-align: center; margin-bottom: 60px; }
  .section-label {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sage-500);
    margin-bottom: 12px;
  }
  .section-header h2 {
    font-size: clamp(24px, 3.5vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 12px;
  }
  .section-header p {
    font-size: 16px;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto;
  }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .pillar-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 40px 32px;
    text-align: center;
    transition: all var(--transition);
  }
  .pillar-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
    border-color: var(--sage-300);
  }
  .pillar-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
  }
  .pillar-icon .material-symbols-outlined { font-size: 28px; }
  .pillar-card h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
  }
  .pillar-card p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  @media (max-width: 768px) {
    .pillars-grid { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
  }
</style>
