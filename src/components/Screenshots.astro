---
import { Image } from 'astro:assets';
import imgMain from '../assets/img_main.webp';
import img1 from '../assets/img_analytics1.webp';
import img2 from '../assets/img_analytics2.webp';
import img3 from '../assets/img_analytics3.webp';
import img4 from '../assets/img_analytics4.webp';
import imgOverall from '../assets/overall_analytics.webp';
import imgExport from '../assets/save therapist pdf report options.webp';
import imgAuth from '../assets/img_auth.webp';
import imgInfo from '../assets/img_info.webp';
import imgReportA from '../assets/img_reportA.webp';

const screens = [
  { img: imgAuth, alt: "Secure PIN entry with biometric fingerprint login", label: "Secure Access" },
  { img: imgInfo, alt: "TheraNode user info details and contextual help", label: "User Info Details" },
  { img: imgMain, alt: "TheraNode daily logging screen with mood, stress, and energy sliders", label: "Daily Logging" },
  { img: img1, alt: "Weekly well-being average score with radar chart and week-at-a-glance stats", label: "Weekly Analytics" },
  { img: img2, alt: "Sleep vs Stress balance chart and Inner Balance tracker", label: "Sleep & Stress" },
  { img: img3, alt: "Mood vs Energy correlation bar chart with weekly emoji snapshot", label: "Mood Patterns" },
  { img: img4, alt: "Tag impact analysis, trend insights, and PDF export button", label: "Smart Insights" },
  { img: imgOverall, alt: "All-time trends showing well-being, mood, stress, and motivation across weeks", label: "All-Time Trends" },
  { img: imgExport, alt: "Share exported PDF file menu with email therapist, share via OS, and save options", label: "Therapist Export" },
  { img: imgReportA, alt: "TheraNode professional PDF report preview", label: "Professional Reports" },
];
---

<section class="screenshots" id="screenshots">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label" data-i18n="screen.label">App Preview</span>
      <h2 data-i18n="screen.h2">See TheraNode in Action</h2>
      <p data-i18n="screen.desc">Real screenshots from the application — no mockups, no placeholders.</p>
    </div>
    <div class="screenshot-scroll">
      <div class="screenshot-track">
        {screens.map((s, i) => (
          <div class={`screenshot-item reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="screenshot-phone">
              <Image src={s.img} alt={s.alt} width={260} height={520} class="screenshot-img" />
            </div>
            <span class="screenshot-label" data-i18n={`screen.${i + 1}`}>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
    <p class="scroll-hint reveal">
      <span class="material-symbols-outlined">swipe_left</span>
      Swipe to see more screens
    </p>
  </div>
</section>

<style>
  .screenshots { padding: 100px 0; background: var(--bg-alt); }
  .section-header { text-align: center; margin-bottom: 60px; }
  .section-label {
    display: inline-block; font-size: 12px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--sage-500); margin-bottom: 12px;
  }
  .section-header h2 {
    font-size: clamp(24px, 3.5vw, 34px); font-weight: 700;
    letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 12px;
  }
  .section-header p { font-size: 16px; color: var(--text-secondary); max-width: 480px; margin: 0 auto; }
  .screenshot-scroll {
    overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch;
    scrollbar-width: thin; scrollbar-color: var(--sage-300) transparent;
  }
  .screenshot-track {
    display: flex; gap: 28px; min-width: min-content; padding: 16px 24px 32px;
  }
  .screenshot-item { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .screenshot-phone {
    width: 220px; border-radius: 24px; overflow: hidden;
    border: 6px solid var(--sage-200); box-shadow: 0 16px 48px rgba(30,41,59,0.10);
    background: #fff; transition: all var(--transition);
  }
  .screenshot-phone:hover { transform: translateY(-8px) scale(1.02); box-shadow: 0 24px 56px rgba(30,41,59,0.15); }
  .screenshot-img { 
    width: 100%; 
    height: auto; 
    display: block; 
    margin-bottom: -4%; /* Crops out the black Android navigation bar */
  }
  .screenshot-label { font-size: 13px; font-weight: 600; color: var(--sage-600); letter-spacing: 0.02em; }
  .scroll-hint {
    text-align: center; margin-top: 24px; font-size: 13px; color: var(--text-muted);
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .scroll-hint .material-symbols-outlined { font-size: 18px; }
  @media (min-width: 1400px) {
    .screenshot-track { justify-content: center; }
    .scroll-hint { display: none; }
  }
</style>

<script>
  const scrollContainer = document.querySelector('.screenshot-scroll') as HTMLElement;
  if (scrollContainer) {
    let isDown = false;
    let startX: number;
    let scrollLeft: number;
    let autoScrollInterval: number;
    let scrollSpeed = 1;

    // --- Drag to Scroll Logic ---
    scrollContainer.addEventListener('mousedown', (e) => {
      isDown = true;
      scrollContainer.classList.add('active');
      startX = e.pageX - scrollContainer.offsetLeft;
      scrollLeft = scrollContainer.scrollLeft;
      stopAutoScroll();
    });
    
    scrollContainer.addEventListener('mouseleave', () => {
      isDown = false;
      scrollContainer.classList.remove('active');
      startAutoScroll();
    });
    
    scrollContainer.addEventListener('mouseup', () => {
      isDown = false;
      scrollContainer.classList.remove('active');
      startAutoScroll();
    });
    
    scrollContainer.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - scrollContainer.offsetLeft;
      const walk = (x - startX) * 2; // Scroll speed multiplier
      scrollContainer.scrollLeft = scrollLeft - walk;
    });

    // --- Auto Rotate Logic ---
    const startAutoScroll = () => {
      stopAutoScroll(); // Ensure no duplicates
      autoScrollInterval = window.setInterval(() => {
        if (!isDown) {
          scrollContainer.scrollLeft += scrollSpeed;
          // Reverse direction if we hit the ends
          if (scrollContainer.scrollLeft >= (scrollContainer.scrollWidth - scrollContainer.clientWidth - 1)) {
            scrollSpeed = -1;
          } else if (scrollContainer.scrollLeft <= 0) {
            scrollSpeed = 1;
          }
        }
      }, 30);
    };

    const stopAutoScroll = () => clearInterval(autoScrollInterval);

    // Pause auto-rotation when hovering over the container
    scrollContainer.addEventListener('mouseenter', stopAutoScroll);
    scrollContainer.addEventListener('touchstart', stopAutoScroll, { passive: true });
    scrollContainer.addEventListener('touchend', startAutoScroll);

    // Start auto-scroll initially
    startAutoScroll();
  }
</script>
