---
import { Image } from 'astro:assets';
import imgAuth from '../assets/img_auth.webp';
import imgMain from '../assets/img_main.webp';
import imgTextbox from '../assets/img_textbox.webp';
import imgInfo from '../assets/img_info.webp';
import imgAnalytics from '../assets/img_analytics1.webp';
import imgOverall from '../assets/overall_analytics.webp';
import imgSplash from '../assets/img_splashscreen.webp';
import imgEmergency from '../assets/img_emergency popup B.webp';
---

<section class="hero">
  <div class="hero-bg-glow"></div>
  <div class="container hero-inner">
    <div class="hero-intro reveal">
      <div class="hero-badge">
        <span class="material-symbols-outlined">self_improvement</span>
        <span data-i18n="hero.badge">Your Private Mental Companion</span>
      </div>
      <h1>
        <span data-i18n="hero.h1_1">Understand Your Mood.</span><br/>
        <span data-i18n="hero.h1_2">Spot The Patterns.</span><br/>
        <span class="hero-accent" data-i18n="hero.h1_3">Own Your Truth.</span>
      </h1>
    </div>
    <div class="hero-details reveal reveal-delay-1">
      <p class="hero-sub" data-i18n="hero.sub">
        Social media, work pressure, daily struggles — your brain is quietly
        absorbing stress you can't even name. TheraNode helps you track how you
        actually feel, spot hidden patterns, and break negative spirals before
        they take root.<br/>No cloud. No accounts. Just you and your truth.
      </p>
      
      <div class="hero-actions">
        <a href="#how-it-works" class="btn-primary" data-i18n="hero.btnPrimary">See How It Works</a>
        <a href="#screenshots" class="btn-outline" data-i18n="hero.btnOutline">Try the App</a>
      </div>
    </div>
    <div class="hero-carousel reveal reveal-delay-2">
      <div class="carousel-container">
        <div class="carousel-spinner" id="hero-spinner">
          <div class="carousel-panel" style="--i: 0;">
            <div class="phone-frame"><Image src={imgAuth} alt="TheraNode biometric login" width={280} height={560} class="phone-screen" loading="eager" /></div>
          </div>
          <div class="carousel-panel" style="--i: 1;">
            <div class="phone-frame"><Image src={imgMain} alt="TheraNode daily logging" width={280} height={560} class="phone-screen" loading="eager" /></div>
          </div>
          <div class="carousel-panel" style="--i: 2;">
            <div class="phone-frame"><Image src={imgTextbox} alt="TheraNode contextual notes" width={280} height={560} class="phone-screen" loading="eager" /></div>
          </div>
          <div class="carousel-panel" style="--i: 3;">
            <div class="phone-frame"><Image src={imgInfo} alt="TheraNode indicator details" width={280} height={560} class="phone-screen" loading="eager" /></div>
          </div>
          <div class="carousel-panel" style="--i: 4;">
            <div class="phone-frame"><Image src={imgAnalytics} alt="TheraNode weekly analytics" width={280} height={560} class="phone-screen" loading="eager" /></div>
          </div>
          <div class="carousel-panel" style="--i: 5;">
            <div class="phone-frame"><Image src={imgOverall} alt="TheraNode all time trends" width={280} height={560} class="phone-screen" loading="eager" /></div>
          </div>
          <div class="carousel-panel" style="--i: 6;">
            <div class="phone-frame"><Image src={imgSplash} alt="TheraNode splash screen" width={280} height={560} class="phone-screen" loading="eager" /></div>
          </div>
          <div class="carousel-panel" style="--i: 7;">
            <div class="phone-frame"><Image src={imgEmergency} alt="TheraNode emergency contact" width={280} height={560} class="phone-screen" loading="eager" /></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 80px 0 100px;
    overflow: hidden;
    background: linear-gradient(175deg, #fff 0%, var(--sage-50) 50%, var(--bg-alt) 100%);
  }
  .hero-bg-glow {
    position: absolute;
    top: -120px;
    right: -80px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(144,193,167,0.25) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 60px;
    align-items: center;
    grid-template-areas: 
      "intro carousel"
      "details carousel";
  }
  .hero-intro { grid-area: intro; align-self: end; padding-bottom: 24px; }
  .hero-details { grid-area: details; align-self: start; }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--sage-100);
    color: var(--primary-dark);
    padding: 8px 18px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    margin-bottom: 24px;
  }
  .hero-badge .material-symbols-outlined { font-size: 16px; }
  h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 20px;
  }
  .hero-accent { color: var(--primary-dark); }
  .hero-sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 520px;
    margin-bottom: 32px;
  }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    background: var(--primary-dark);
    color: #fff;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 600;
    transition: all var(--transition);
  }
  .btn-primary:hover { background: var(--sage-700); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(57,103,82,0.25); }
  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 14px 32px;
    border: 1.5px solid var(--sage-300);
    color: var(--text-primary);
    border-radius: 100px;
    font-size: 15px;
    font-weight: 600;
    transition: all var(--transition);
  }
  .btn-outline:hover { border-color: var(--primary-dark); color: var(--primary-dark); }

  .hero-carousel {
    grid-area: carousel;
    display: flex;
    justify-content: center;
    perspective: 1200px;
    z-index: 10;
  }
  .carousel-container {
    width: 260px;
    height: 540px;
    position: relative;
    transform-style: preserve-3d;
    transform: scale(0.95); /* Shrinks the carousel so it doesn't cover text */
    transform-origin: center right; /* Keeps it anchored to the right side */
  }
  .carousel-spinner {
    width: 80%;
    height: 80%;
    position: absolute;
    transform-style: preserve-3d;
  }
  .carousel-panel {
    position: absolute;
    top: 60px;
    left: 0;
    width: 100%;
    height: 100%;
    /* 360deg / 8 panels = 45deg. TranslateZ dictates circle radius (space between items). */
    transform: rotateY(calc(var(--i) * -45deg)) translateZ(280px);
  }

  .phone-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 32px;
    overflow: hidden;
    border: 8px solid var(--sage-200);
    box-shadow: 0 24px 64px rgba(30,41,59,0.12), 0 0 0 1px rgba(107,135,120,0.08);
    background: #fff;
    /* Optional backface visibility to hide cards in the back */
    /* backface-visibility: hidden; */
  }
  .phone-screen { 
    width: 100%; 
    height: auto; 
    display: block; 
    margin-bottom: -4%; /* Crop Android nav bar */
  }

  @media (max-width: 900px) {
    .hero-inner { 
      display: flex;
      flex-direction: column;
      text-align: center; 
      gap: 16px;
    }
    .hero-intro { padding-bottom: 0; order: 1; align-self: center; }
    .hero-carousel { margin-top: -64px; margin-bottom: -48px; order: 2; align-self: center; }
    .hero-details { order: 3; align-self: center; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .hero-actions { justify-content: center; }
    
    .carousel-spinner { left: 10%; }
    .carousel-container { transform: scale(0.7); transform-origin: center center; }
    .hero-bg-glow { top: -60px; right: -120px; width: 300px; height: 300px; }
  }
</style>

<script>
  // Continuous 3D Carousel Rotation
  const spinner = document.getElementById('hero-spinner');
  if (spinner) {
    let angle = 0;
    const speed = 0.25; // Rotation speed in degrees per frame
    
    function animate() {
      angle += speed;
      // Wrap angle to prevent float precision issues over long periods
      if (angle >= 360) angle -= 360;
      spinner.style.transform = `rotateY(${angle}deg)`;
      requestAnimationFrame(animate);
    }
    
    // Start animation
    requestAnimationFrame(animate);
  }
</script>
